# A classic token needs repo (for private repositories) and read:user.
# A fine-grained token needs Metadata: read and Contents: read for selected repositories.
GITHUB_TOKEN=replace-with-github-read-token
GITHUB_USERNAME=your-github-login

GITEA_URL=https://gitea.example.com
# Token owner must be able to create repositories in both target namespaces and push Git.
GITEA_TOKEN=replace-with-gitea-token
GITEA_OWNED_NAMESPACE=github-backups
GITEA_STARRED_NAMESPACE=github-archive

# Supports seconds or suffixes s, m, h, d.
SYNC_INTERVAL=6h
SYNC_ON_STARTUP=true
DATABASE_PATH=/data/githarbor.db
DESTINATION_PRIVATE=true
API_TIMEOUT_SECONDS=30
# Fetch and upload every LFS object reachable from mirrored refs before pushing those refs.
GIT_LFS_ENABLED=true
GIT_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO
