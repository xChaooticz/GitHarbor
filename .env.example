# Docker Compose deployment image. Pin this to a release such as v0.7.1 for reproducible upgrades.
GITHARBOR_IMAGE_TAG=latest
# Dashboard listener on the Docker host. 0.0.0.0 makes it reachable across the private LAN.
GITHARBOR_BIND_ADDRESS=0.0.0.0
GITHARBOR_PORT=9005

# One classic GitHub PAT is used for every GitHub read and optional private GHCR login.
# Grant repo and read:packages. No other GitHub scopes are required.
GITHUB_TOKEN=replace-with-github-token
GITHUB_USERNAME=your-github-login

GITEA_URL=https://gitea.example.com
# Organization targets need read:user, write:organization, and write:repository.
# Token owner must be able to create repositories in every selected namespace and push Git.
GITEA_TOKEN=replace-with-gitea-token
GITEA_OWNED_NAMESPACE=github-backups
GITEA_STARRED_NAMESPACE=github-archive

# Supports seconds or suffixes s, m, h, d.
SYNC_INTERVAL=6h
SYNC_ON_STARTUP=true
# Maximum repositories mirrored at once during a global synchronization.
SYNC_CONCURRENCY=3
DATABASE_PATH=/data/githarbor.db
DESTINATION_PRIVATE=true
API_TIMEOUT_SECONDS=30
# Optional mirror layers. Disabling one preserves existing Gitea data without updating it.
WIKI_ENABLED=true
RELEASES_ENABLED=true
RELEASE_ASSETS_ENABLED=true
# all mirrors assets from every release; latest follows the source provider's latest stable release.
RELEASE_ASSET_MODE=all
# Timeout for each individual source release-asset download or Gitea upload.
RELEASE_ASSET_TIMEOUT_SECONDS=3600
# Container packages are opt-in, use GITHUB_TOKEN, and mirror only packages linked to owned repos.
PACKAGES_ENABLED=false
GITHUB_CONTAINER_REGISTRY=ghcr.io
# all preserves every digest and source tag; latest follows the literal latest tag only.
CONTAINER_IMAGE_MODE=all
# Optional conservative per-image estimate; 0 disables this client-side limit.
PACKAGE_MAX_BYTES=0
PACKAGE_TRANSFER_TIMEOUT_SECONDS=3600
# Fetch and upload every LFS object reachable from mirrored refs before pushing those refs.
GIT_LFS_ENABLED=true
GIT_TIMEOUT_SECONDS=3600
# Persistent bare-clone cache. Later syncs fetch changes into these mirrors rather than re-cloning.
GIT_CACHE_PATH=/data/git-mirrors
# Remove caches for repositories absent from discovery after this many days; 0 removes immediately.
GIT_CACHE_RETENTION_DAYS=30
# Optional TOML inventory for explicit Forgejo and GitLab repository URLs.
# Mount the file read-only when running in Docker. Leave blank to disable external sources.
EXTERNAL_SOURCES_FILE=
# Tokens named by token_env in that file are supplied separately as environment variables.
# EDEN_FORGEJO_TOKEN=replace-with-read-only-source-token
# Disabled by default. Enables the dashboard's stop-sync and bulk organization-reset controls.
# Use a separate random value, never GITEA_TOKEN; it is requested for every destructive action.
ADMIN_ACTIONS_ENABLED=false
ADMIN_ACTIONS_TOKEN=
LOG_LEVEL=INFO
